  "proposed_cases": [
    {
      "id": "C21",
      "scenario": "old desktop against new handshake",
      "input": "runtime=2 schema=7 product=0.1.0",
      "expected": "incompatible_runtime before any writer callback",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C22",
      "scenario": "new client against baseline server",
      "input": "no contract.describe or read capability",
      "expected": "legacy first-page search only; complete read unsupported",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C23",
      "scenario": "existing search-only MCP agent",
      "input": "content/history grants absent",
      "expected": "brain_read/history tools absent and calls denied",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C24",
      "scenario": "explicit content-read without history-read",
      "input": "read current then history.show",
      "expected": "current projected text allowed; history denied",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C25",
      "scenario": "explicit history-read without content-read",
      "input": "show retained old revision",
      "expected": "historical projected text allowed; current read operation denied",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C26",
      "scenario": "new DTO strict producer/consumer",
      "input": "extra keys, wrong version, duplicate keys, nonfinite numbers",
      "expected": "invalid_arguments before execution",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C27",
      "scenario": "old writer already running",
      "input": "migration requests exclusive admission",
      "expected": "cutover blocked until old session exits",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C28",
      "scenario": "old writer after cutover",
      "input": "CLI, MCP, plugin, collector, importer entry",
      "expected": "schema/runtime refusal before any durable write",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C29",
      "scenario": "paged deterministic search",
      "input": "201 matching IDs; same score ties; page limits 1,10,100",
      "expected": "all 201 exactly once, complete iff next_cursor null",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C30",
      "scenario": "filter/authority intersection",
      "input": "two spaces, all families, source/canonical; narrower allowed scope",
      "expected": "no excluded result/count/title leakage",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C31",
      "scenario": "full Unicode read",
      "input": "long text recipe in security-boundaries; target 32768",
      "expected": "exact projected UTF-8 reconstruction including middle/end",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C32",
      "scenario": "hybrid mode negotiation",
      "input": "optional helper absent or projection stale",
      "expected": "preferred warns lexical; required returns typed error; no auto-download",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C33",
      "scenario": "legacy search on compatible updated client",
      "input": "query and limit only",
      "expected": "same nine result keys and legacy limits; no paging/full-content extras",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C34",
      "scenario": "error adapter parity",
      "input": "each new code from design section 9",
      "expected": "safe code survives CLI/MCP/bridge; no private exception text",
      "execution_status": "not_run_requires_future_implementation"
    },
    {
      "id": "C35",
      "scenario": "new Portable v4 export",
      "input": "retained v1-v3 payloads plus v4 metadata",

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Optional example only. Choose launchd OR systemd OR a resident runner.
     Replace synthetic paths; preserve the shared collector lease path. -->
<plist version="1.0"><dict>
  <key>Label</key><string>io.openbrain.slack-capture.example</string>
  <key>ProgramArguments</key><array>
    <string>/absolute/path/to/open-brain-collector</string><string>run-until-caught-up</string>
    <string>--state</string><string>/absolute/path/to/private/collector/state.json</string>
    <string>--brain-root</string><string>/absolute/path/to/private/brain</string>
    <string>--lease</string><string>/absolute/path/to/private/collector/collector.lease</string>
    <string>--max-iterations</string><string>500</string>
    <string>--max-seconds</string><string>900</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  <key>Umask</key><integer>63</integer>
</dict></plist>

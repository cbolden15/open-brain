  "cards": [
    {
      "dot": "cyan",
      "title": "Current implementation",
      "items": [
        "Core records, reviewed publication, source continuity, and Slack noteworthy capture are implemented.",
        "Real Slack acceptance still requires an owner-run test with a registered PKCE app."
      ]
    },
    {
      "dot": "emerald",
      "title": "One local authority",
      "items": [
        "The engine owns revisions, redaction, conflict checks and writer admission.",
        "The collector may capture and propose; only an owner decision can change the vault."
      ]
    },
    {
      "dot": "violet",
      "title": "Slack policy and review",
      "items": [
        "The CLI writes versioned policy under private collector state; heuristics only suggest channels.",
        "Daily discovery, four-hour selected capture, and revision-bound append patches fail closed."
      ]
    }

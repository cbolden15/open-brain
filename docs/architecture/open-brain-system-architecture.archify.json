  "cards": [
    {
      "dot": "cyan",
      "title": "Foreground core boundary",
      "items": [
        "CLI calls are short lived; MCP and the Obsidian child use inherited stdio",
        "The core needs no listener, daemon, root staging, namespace, or capability setup"
      ]
    },
    {
      "dot": "violet",
      "title": "Two graph paths",
      "items": [
        "Graphify extracts explicit Markdown links locally into a rebuildable projection",
        "Consent-gated model calls create evidence-bound suggestions for owner review"
      ]
    },

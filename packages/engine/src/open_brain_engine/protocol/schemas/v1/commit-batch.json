{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:protocol:v1:commit-batch",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/schema_version" },
    "brain_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/brain_id" },
    "delivery_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/delivery_id" },
    "sequencer_epoch": { "type": "integer", "minimum": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "oneOf": [
          { "$ref": "urn:open-brain:protocol:v1:record" },
          { "$ref": "urn:open-brain:protocol:v1:revision" },
          { "$ref": "urn:open-brain:protocol:v1:decision" },
          { "$ref": "urn:open-brain:protocol:v1:purge-transition" }
        ]
      }
    }
  },
  "required": ["schema_version", "brain_id", "delivery_id", "sequencer_epoch", "items"],
  "additionalProperties": false
}

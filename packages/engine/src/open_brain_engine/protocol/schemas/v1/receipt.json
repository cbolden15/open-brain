{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:protocol:v1:receipt",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/schema_version" },
    "receipt_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/receipt_id" },
    "brain_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/brain_id" },
    "commit_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/commit_id" },
    "delivery_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/delivery_id" },
    "cursor": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/cursor" },
    "commit_digest": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/digest" },
    "node_key_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/key_id" },
    "node_epoch_certificate": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/base64url" },
    "owner_key_history": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/base64url" }
    },
    "issued_at": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/timestamp" },
    "node_signature": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/base64url" }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "brain_id",
    "commit_id",
    "delivery_id",
    "cursor",
    "commit_digest",
    "node_key_id",
    "node_epoch_certificate",
    "owner_key_history",
    "issued_at",
    "node_signature"
  ],
  "additionalProperties": false
}

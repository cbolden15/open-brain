{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:protocol:v1:decision",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/schema_version" },
    "kind": { "const": "decision" },
    "brain_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/brain_id" },
    "decision_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/decision_id" },
    "proposal_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/proposal_id" },
    "expected_revision_id": {
      "oneOf": [
        { "$ref": "urn:open-brain:protocol:v1:common#/$defs/revision_id" },
        { "type": "null" }
      ]
    },
    "outcome": { "enum": ["accepted", "rejected"] },
    "decided_at": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/timestamp" }
  },
  "required": [
    "schema_version",
    "kind",
    "brain_id",
    "decision_id",
    "proposal_id",
    "expected_revision_id",
    "outcome",
    "decided_at"
  ],
  "additionalProperties": false
}

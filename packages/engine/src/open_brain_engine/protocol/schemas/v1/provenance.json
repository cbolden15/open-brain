{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:protocol:v1:provenance",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/schema_version" },
    "brain_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/brain_id" },
    "source_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/record_id" }
    },
    "processor": { "type": ["string", "null"], "maxLength": 128 },
    "derivation": { "enum": ["owner", "import", "processor", "replacement"] }
  },
  "required": ["schema_version", "brain_id", "source_record_ids", "processor", "derivation"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:draft:facets:c0:evidence-v1",
  "title": "C0 draft facet evidence; not a registered Portable catalog",
  "x-contract-revision": "facets-c0-v3",
  "x-sidecar-paths": {
    "events_sidecar": "history/facets/events-v1.json",
    "operations_sidecar": "history/facets/operations-v1.json",
    "state_sidecar": "content/facets/state-v1.json"
  },
  "$defs": {
    "actor_id": {
      "type": "string",
      "pattern": "^actor_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capture_id": {
      "type": "string",
      "pattern": "^capture_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "page_id": {
      "type": "string",
      "pattern": "^page_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^publication_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "route_id": {
      "type": "string",
      "pattern": "^route_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "space_id": {
      "type": "string",
      "pattern": "^space_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "role_claim": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/actor_id"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "uniqueItems": true
        },
        "role_claim_id": {
          "type": "string",
          "pattern": "^role_claim_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "role_id": {
          "type": "string",
          "pattern": "^role_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "tenant_id": {
          "$ref": "#/$defs/tenant_id"
        }
      },
      "required": [
        "actor_id",
        "capabilities",
        "role_claim_id",
        "role_id",
        "tenant_id"
      ],
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^source_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^revision_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "facetdim_id": {
      "type": "string",
      "pattern": "^facetdim_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "facetval_id": {
      "type": "string",
      "pattern": "^facetval_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "facetquery_id": {
      "type": "string",
      "pattern": "^facetquery_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "facetevent_id": {
      "type": "string",
      "pattern": "^facetevent_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "brain_id": {
      "type": "string",
      "pattern": "^brn_[a-z2-7]{26}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
      "x-normalized": "NFC stripped"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
    },
    "subject": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "id": {
              "$ref": "#/$defs/source_id"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "canonical"
            },
            "id": {
              "$ref": "#/$defs/page_id"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "all_value_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/facetval_id"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 32
        },
        "space_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/space_id"
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 256
        },
        "payload_families": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "event",
              "measurement",
              "reference_or_file"
            ]
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 4
        },
        "record_types": {
          "type": "array",
          "items": {
            "enum": [
              "source",
              "canonical"
            ]
          },
          "minItems": 0,
          "uniqueItems": true,
          "maxItems": 2
        }
      },
      "required": [
        "all_value_ids",
        "space_ids",
        "payload_families",
        "record_types"
      ],
      "additionalProperties": false
    },
    "dimension_row": {
      "type": "object",
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/facetdim_id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "archived": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "dimension_id",
        "name",
        "archived",
        "version",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "value_row": {
      "type": "object",
      "properties": {
        "value_id": {
          "$ref": "#/$defs/facetval_id"
        },
        "dimension_id": {
          "$ref": "#/$defs/facetdim_id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "archived": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "value_id",
        "dimension_id",
        "name",
        "archived",
        "version",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "subject_row": {
      "type": "object",
      "properties": {
        "subject_kind": {
          "enum": [
            "source",
            "canonical"
          ]
        },
        "subject_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_id"
            },
            {
              "$ref": "#/$defs/page_id"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "subject_kind",
        "subject_id",
        "version"
      ],
      "additionalProperties": false
    },
    "assignment_row": {
      "type": "object",
      "properties": {
        "subject_kind": {
          "enum": [
            "source",
            "canonical"
          ]
        },
        "subject_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_id"
            },
            {
              "$ref": "#/$defs/page_id"
            }
          ]
        },
        "value_id": {
          "$ref": "#/$defs/facetval_id"
        },
        "present": {
          "type": "boolean"
        },
        "membership_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "last_event_sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "subject_kind",
        "subject_id",
        "value_id",
        "present",
        "membership_version",
        "last_event_sequence"
      ],
      "additionalProperties": false
    },
    "query_row": {
      "type": "object",
      "properties": {
        "query_id": {
          "$ref": "#/$defs/facetquery_id"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "archived": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        },
        "selection_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "query_id",
        "name",
        "selector",
        "archived",
        "version",
        "created_at",
        "updated_at",
        "selection_version"
      ],
      "additionalProperties": false
    },
    "attachment_row": {
      "type": "object",
      "properties": {
        "page_id": {
          "$ref": "#/$defs/page_id"
        },
        "query_id": {
          "$ref": "#/$defs/facetquery_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "page_id",
        "query_id",
        "version"
      ],
      "additionalProperties": false
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "dimension"
                },
                "id": {
                  "$ref": "#/$defs/facetdim_id"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "before": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/dimension_row"
                }
              ]
            },
            "after": {
              "$ref": "#/$defs/dimension_row"
            }
          },
          "required": [
            "entity",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "value"
                },
                "id": {
                  "$ref": "#/$defs/facetval_id"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "before": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/value_row"
                }
              ]
            },
            "after": {
              "$ref": "#/$defs/value_row"
            }
          },
          "required": [
            "entity",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "subject"
                },
                "id": {
                  "$ref": "#/$defs/subject"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "before": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/subject_row"
                }
              ]
            },
            "after": {
              "$ref": "#/$defs/subject_row"
            }
          },
          "required": [
            "entity",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "assignment"
                },
                "id": {
                  "type": "object",
                  "properties": {
                    "subject_kind": {
                      "enum": [
                        "source",
                        "canonical"
                      ]
                    },
                    "subject_id": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/source_id"
                        },
                        {
                          "$ref": "#/$defs/page_id"
                        }
                      ]
                    },
                    "value_id": {
                      "$ref": "#/$defs/facetval_id"
                    }
                  },
                  "required": [
                    "subject_kind",
                    "subject_id",
                    "value_id"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "before": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/assignment_row"
                }
              ]
            },
            "after": {
              "$ref": "#/$defs/assignment_row"
            }
          },
          "required": [
            "entity",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "query"
                },
                "id": {
                  "$ref": "#/$defs/facetquery_id"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "before": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/query_row"
                }
              ]
            },
            "after": {
              "$ref": "#/$defs/query_row"
            }
          },
          "required": [
            "entity",
            "before",
            "after"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "entity": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "attachment"
                },
                "id": {
                  "$ref": "#/$defs/page_id"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            },
            "before": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/attachment_row"
                }
              ]
            },
            "after": {
              "$ref": "#/$defs/attachment_row"
            }
          },
          "required": [
            "entity",
            "before",
            "after"
          ],
          "additionalProperties": false
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "brain_id": {
          "$ref": "#/$defs/brain_id"
        },
        "event_id": {
          "$ref": "#/$defs/facetevent_id"
        },
        "actor_id": {
          "$ref": "#/$defs/actor_id"
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "recorded_at": {
          "$ref": "#/$defs/timestamp"
        },
        "kind": {
          "enum": [
            "dimension.create",
            "dimension.rename",
            "dimension.archive",
            "value.create",
            "value.rename",
            "value.archive",
            "assignment.patch",
            "query.create",
            "query.update",
            "query.archive",
            "query.attach"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          },
          "minItems": 1,
          "uniqueItems": true,
          "maxItems": 129
        }
      },
      "required": [
        "schema_version",
        "brain_id",
        "event_id",
        "actor_id",
        "operation_id",
        "sequence",
        "recorded_at",
        "kind",
        "changes"
      ],
      "additionalProperties": false
    },
    "facet_dimension_create_request": {
      "type": "object",
      "properties": {
        "dto_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "dto_version",
        "operation_id",
        "expected_version",
        "name"
      ],
      "additionalProperties": false
    },
    "facet_dimension_rename_request": {
      "type": "object",
      "properties": {
        "dto_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dimension_id": {
          "$ref": "#/$defs/facetdim_id"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "dto_version",
        "operation_id",
        "expected_version",
        "dimension_id",
        "name"
      ],
      "additionalProperties": false
    },
    "facet_dimension_archive_request": {
      "type": "object",
      "properties": {
        "dto_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dimension_id": {
          "$ref": "#/$defs/facetdim_id"
        }
      },
      "required": [
        "dto_version",
        "operation_id",
        "expected_version",
        "dimension_id"
      ],
      "additionalProperties": false
    },
    "facet_value_create_request": {
      "type": "object",
      "properties": {
        "dto_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dimension_id": {
          "$ref": "#/$defs/facetdim_id"
        },
        "expected_dimension_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "dto_version",
        "operation_id",
        "expected_version",
        "dimension_id",
        "expected_dimension_version",
        "name"
      ],
      "additionalProperties": false
    },
    "facet_value_rename_request": {
      "type": "object",
      "properties": {
        "dto_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value_id": {
          "$ref": "#/$defs/facetval_id"
        },
        "name": {
          "$ref": "#/$defs/name"
        }
      },
      "required": [
        "dto_version",
        "operation_id",
        "expected_version",
        "value_id",
        "name"
      ],
      "additionalProperties": false
    },
    "facet_value_archive_request": {
      "type": "object",
      "properties": {
        "dto_version": {
          "const": 1
        },
        "operation_id": {
          "$ref": "#/$defs/operation_id"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Brain Desktop",
  "version": "0.1.0",
  "identifier": "io.openbrain.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Open Brain",
        "width": 1080,
        "height": 760,
        "minWidth": 640,
        "minHeight": 540,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": ["icons/icon.png"],
    "resources": ["binaries"],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Native companion for a local Open Brain"
  }
}

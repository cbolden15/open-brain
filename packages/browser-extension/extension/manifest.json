{
  "manifest_version": 3,
  "name": "Open Brain saved items",
  "version": "0.1.0",
  "minimum_chrome_version": "127",
  "key": "",
  "permissions": ["activeTab", "scripting", "contextMenus", "nativeMessaging", "storage"],
  "action": {"default_popup": "popup.html", "default_title": "Save to Open Brain"},
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'none'; frame-src 'none'; base-uri 'none'"}
}

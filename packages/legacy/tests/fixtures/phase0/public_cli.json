{
  "parser": {
    "command_families": [
      "backup",
      "capture",
      "close-day",
      "config",
      "cron",
      "curation",
      "dev",
      "digest",
      "doctor",
      "explain",
      "hooks",
      "inbox",
      "index",
      "ledger",
      "lifeos",
      "lint",
      "messages",
      "migrate",
      "now",
      "okf",
      "ops",
      "proposals",
      "query",
      "registry",
      "retention",
      "review",
      "share",
      "social",
      "spaces",
      "status",
      "ui"
    ],
    "global_options": [
      "--dry-run",
      "--help",
      "--json",
      "--version",
      "-h"
    ]
  },
  "scheduled_routes": [
    {"job_id": "JOB-001", "path": ["doctor"], "options": ["--json", "--role=probe"], "adapter": "optional"},
    {"job_id": "JOB-002", "path": ["index"], "options": ["--check", "--json", "--read-only"], "adapter": "optional"},
    {"job_id": "JOB-003", "path": ["now", "check"], "options": ["--json", "--read-only"], "adapter": "optional"},
    {"job_id": "JOB-004", "path": ["backup", "sqlite"], "options": ["--dry-run", "--json", "--profile=local"], "adapter": "optional"},
    {"job_id": "JOB-005", "path": ["capture", "imessage-ingress"], "options": ["--append", "--json"], "adapter": "capture"},
    {"job_id": "JOB-006", "path": ["close-day", "prepare"], "options": ["--dry-run", "--json"], "adapter": "writer"},
    {"job_id": "JOB-007", "path": ["dev", "signals", "scan"], "options": ["--append-only", "--json"], "adapter": "writer"},
    {"job_id": "JOB-008", "path": ["lint"], "options": ["--json", "--scope=work", "--write-report"], "adapter": "writer"},
    {"job_id": "JOB-009", "path": ["hooks", "sync"], "options": ["--dry-run", "--json"], "adapter": "writer"},
    {"job_id": "JOB-010", "path": ["ledger", "run"], "options": ["--json", "--nightly"], "adapter": "writer"},
    {"job_id": "JOB-011", "path": ["backup", "run"], "options": ["--json", "--profile=capture"], "adapter": "writer"},
    {"job_id": "JOB-012", "path": ["curation", "run"], "options": ["--day=yesterday", "--json"], "adapter": "writer"},
    {"job_id": "JOB-013", "path": ["doctor"], "options": ["--json", "--role=writer"], "adapter": "optional"},
    {"job_id": "JOB-014", "path": ["backup", "run"], "options": ["--json", "--profile=full"], "adapter": "writer"},
    {"job_id": "JOB-015", "path": ["ops", "git-sync"], "options": ["--json"], "adapter": "writer"},
    {"job_id": "JOB-016", "path": ["index"], "options": ["--json", "--scope=all"], "adapter": "writer"},
    {"job_id": "JOB-017", "path": ["lifeos", "nudge", "midday"], "options": ["--date=CONFIGURED_DATE", "--json"], "adapter": "optional"},
    {"job_id": "JOB-018", "path": ["lifeos", "plan"], "options": ["--date=CONFIGURED_DATE", "--generic-titles", "--json"], "adapter": "optional"},
    {"job_id": "JOB-019", "path": ["lifeos", "reset"], "options": ["--date=CONFIGURED_DATE", "--json"], "adapter": "optional"},
    {"job_id": "JOB-020", "path": ["messages", "extract"], "options": ["--json", "--review-actions"], "adapter": "optional"},
    {"job_id": "JOB-021", "path": ["messages", "sync"], "options": ["--dry-run", "--json"], "adapter": "optional"},
    {"job_id": "JOB-022", "path": ["now", "build"], "options": ["--json", "--role=writer"], "adapter": "writer"},
    {"job_id": "JOB-023", "path": ["backup", "run"], "options": ["--json", "--profile=personal"], "adapter": "writer"},
    {"job_id": "JOB-024", "path": ["retention", "run"], "options": ["--dry-run", "--json"], "adapter": "optional"},
    {"job_id": "JOB-025", "path": ["backup", "run"], "options": ["--json", "--profile=runtime-state"], "adapter": "writer"},
    {"job_id": "JOB-026", "path": ["ui", "serve"], "options": ["--bind=CONFIGURED_PRIVATE_BIND", "--port=CONFIGURED_PORT"], "adapter": "optional"},
    {"job_id": "JOB-027", "path": ["capture", "serve"], "options": ["--bind=CONFIGURED_PRIVATE_BIND", "--port=CONFIGURED_PORT"], "adapter": "capture"},
    {"job_id": "JOB-028", "path": ["capture", "serve"], "options": ["--bind=CONFIGURED_PRIVATE_BIND", "--mode=ingress", "--port=CONFIGURED_PORT"], "adapter": "capture"},
    {"job_id": "JOB-029", "path": ["capture", "poll"], "options": ["--json", "--mode=ingress", "--source=youtube"], "adapter": "capture"},
    {"job_id": "JOB-030", "path": ["now", "check"], "options": ["--json", "--read-only"], "adapter": "optional"}
  ],
  "packaging": {
    "distribution": "open-brain",
    "version": "0.1.0",
    "entry_points": {
      "open-brain": "open_brain.services.local_entrypoints:run_cli",
      "open-brain-secure-node": "open_brain.services.secure_node_entrypoints:run_cli",
      "open-brain-secure-node-mcp": "open_brain.services.secure_node_entrypoints:run_mcp"
    }
  },
  "exit_classes": {
    "interactive": {"success": 0, "failure": 1, "usage": 2, "deferred": 3},
    "scheduled": {"success": 0, "failure": 1, "lock_held": 75, "configuration": 78}
  },
  "version_behavior": {
    "argv": ["--version"],
    "exit_code": 0,
    "output": "open-brain 0.1.0\n"
  }
}

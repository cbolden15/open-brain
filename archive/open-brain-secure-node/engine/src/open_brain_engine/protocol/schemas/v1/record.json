{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-brain:protocol:v1:record",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/schema_version" },
    "kind": { "const": "record" },
    "brain_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/brain_id" },
    "record_id": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/record_id" },
    "record_type": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$" },
    "content_schema": {
      "$ref": "urn:open-brain:protocol:v1:common#/$defs/schema_reference"
    },
    "producer_principal_id": {
      "$ref": "urn:open-brain:protocol:v1:common#/$defs/principal_id"
    },
    "origin_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 256 },
    "captured_at": {
      "oneOf": [
        { "$ref": "urn:open-brain:protocol:v1:common#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "observed_at": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/timestamp" },
    "compartments": { "$ref": "urn:open-brain:protocol:v1:common#/$defs/compartments" },
    "provenance": { "$ref": "urn:open-brain:protocol:v1:provenance" },
    "body": { "type": "object" },
    "ciphertext_state": { "enum": ["pending", "verified", "unknown_historical"] },
    "ciphertext_digest": {
      "oneOf": [
        { "$ref": "urn:open-brain:protocol:v1:common#/$defs/digest" },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "brain_id",
    "record_id",
    "record_type",
    "content_schema",
    "producer_principal_id",
    "origin_id",
    "captured_at",
    "observed_at",
    "compartments",
    "provenance",
    "body",
    "ciphertext_state",
    "ciphertext_digest"
  ],
  "allOf": [
    {
      "if": { "properties": { "ciphertext_state": { "const": "verified" } } },
      "then": {
        "properties": {
          "ciphertext_digest": {
            "$ref": "urn:open-brain:protocol:v1:common#/$defs/digest"
          }
        }
      },
      "else": { "properties": { "ciphertext_digest": { "type": "null" } } }
    }
  ],
  "additionalProperties": false
}
